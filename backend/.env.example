
# Server
PORT=3777

# MySQL database
DB_HOST=your-aiven-mysql-host
DB_PORT=24500
DB_USER=your_aiven_username
DB_PASS=your_aiven_password
DB_NAME=your_actual_database_name
DB_SSL=true

# Frontend origins, comma-separated if needed
FRONTEND_URL=https://your-frontend.vercel.app

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Embedding retry configuration
GEMINI_EMBED_MAX_RETRIES=3
GEMINI_EMBED_RETRY_BASE_MS=1000
GEMINI_EMBED_BATCH_DELAY_MS=0

# Semantic search
RECOMMEND_THRESHOLD=0.2
SEMANTIC_SEARCH_THRESHOLD=0.6
SEMANTIC_SEARCH_K=2
RECOMMEND_K=10

# Answer ranking
ANSWER_RANK_AI_WEIGHT=0.5
ANSWER_RANK_VOTE_WEIGHT=0.5
ANSWER_GOOD_MIN=0.6
ANSWER_MODERATE_MIN=0.45

# Document uploads and retrieval
RAG_UPLOAD_DIR=uploads/rag
RAG_MAX_UPLOAD_MB=5
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP=120
RAG_MAX_CHUNKS_PER_DOC=1000
RAG_MAX_PDFS_PER_USER=20
RAG_MIN_TEXT_CHARS=50
RAG_SEARCH_THRESHOLD=0.2
RAG_SEARCH_K=10

## Owner Seed Script Configuration
OWNER_FIRST_NAME=placeholder
OWNER_LAST_NAME=placeholder
OWNER_EMAIL=placeholder
OWNER_PASSWORD=placeholder


